# Production Environment Variables for Render
# Copy these to Render Dashboard → Environment Variables

# ═══════════════════════════════════════════════════════════════
# DATABASE (from Neon PostgreSQL)
# ═══════════════════════════════════════════════════════════════
# Format: postgresql://user:password@host/dbname?sslmode=require
# Example: postgresql://user:abc123@ep-small-wave-123.us-east-1.neon.tech/neon?sslmode=require
DATABASE_URL=your_neon_database_url_here_with_sslmode_require

# ═══════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════
APP_TITLE=CommunitySync
APP_VERSION=1.0.0
DEBUG=False
CORS_ORIGINS=["https://communitysync-frontend.onrender.com"]

# ═══════════════════════════════════════════════════════════════
# JWT AUTHENTICATION
# ═══════════════════════════════════════════════════════════════
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=generate_a_new_secure_random_string_here_not_dev_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ═══════════════════════════════════════════════════════════════
# EMAIL (Gmail + App Password)
# ═══════════════════════════════════════════════════════════════
# Gmail App Password guide: https://support.google.com/accounts/answer/185833
EMAIL_USERNAME=your-official-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-specific-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=your-official-email@gmail.com

# ═══════════════════════════════════════════════════════════════
# TWILIO (WhatsApp Notifications)
# ═══════════════════════════════════════════════════════════════
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE=+14155238886
TWILIO_JOIN_CODE=store-creature

# ═══════════════════════════════════════════════════════════════
# AI & EXTERNAL APIs
# ═══════════════════════════════════════════════════════════════

# Groq LLM (AI-powered extraction)
# Get free key: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (Pre-validation)
# Get free key: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCage Geocoding (Location extraction)
# Get free key: https://opencagedata.com/users/sign_up
OPENCAGE_API_KEY=your_opencage_api_key_here

# ═══════════════════════════════════════════════════════════════
# NOTES FOR PRODUCTION
# ═══════════════════════════════════════════════════════════════
# 1. Keep all values in Render dashboard, not in git
# 2. Change JWT_SECRET to production value
# 3. Ensure DATABASE_URL has ?sslmode=require for Neon
# 4. Use Gmail App Password, not your main password
# 5. Test each API key before deploying
# 6. Monitor logs for any auth errors
# 7. Rotate secrets every 90 days
